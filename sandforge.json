{
  "schemaVersion": 2,
  "storage": {
    "retentionDays": 30,
    "maximumWorkspaceSizeMb": 8192,
    "maximumArtifactSizeMb": 256
  },
  "session": {
    "defaultTemplate": "isolated-analysis",
    "defaultTimeout": "15m",
    "maximumConcurrentSessions": 1,
    "keepFailedWorkspaces": true
  },
  "security": {
    "defaultNetwork": "Disabled",
    "defaultClipboard": "Disabled",
    "allowWritableUserProfileMount": false,
    "allowSystemDriveMount": false,
    "allowNoTimeout": false
  },
  "cache": {
    "root": "%LocalAppData%\\SandForge\\cache",
    "allowedTypes": ["nuget", "npm", "pip", "winget"],
    "defaultMaximumSizeMb": 2048
  },
  "updates": {
    "repository": "Onmaynec/SandForge",
    "channel": "preview",
    "autoCheck": true,
    "autoApply": false,
    "intervalHours": 24
  },
  "privacy": {
    "storeMachineName": false,
    "storeUserName": false,
    "redactHostPaths": true
  },
  "ui": {
    "language": "ru",
    "theme": "dark",
    "animations": false
  }
}
