{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandforge.dev/schemas/template.schema.json",
  "title": "SandForge template",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "extends": { "type": "string", "minLength": 1 },
    "includes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "displayName": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "network": { "enum": ["disabled", "enabled", "required"] },
        "clipboard": { "enum": ["disabled", "enabled"] },
        "protectedClient": { "type": "boolean" },
        "memoryMb": { "type": "integer", "minimum": 1024 }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "timeout": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?[smh]$" },
        "keepWorkspace": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "destination", "mode"],
        "properties": {
          "source": { "type": "string" },
          "destination": { "type": "string" },
          "mode": { "enum": ["readOnly", "readWrite", "copyIn", "copyOut"] }
        },
        "additionalProperties": false
      }
    },
    "target": {
      "type": "object",
      "properties": {
        "executable": { "type": "string" },
        "workingDirectory": { "type": "string" },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "wait": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "collectors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "provisioning": {
      "type": "object",
      "properties": {
        "failurePolicy": { "enum": ["stop", "continue"] },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string" },
              "source": { "const": "winget" }
            },
            "additionalProperties": false
          }
        },
        "installers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
              "arguments": { "type": "array", "items": { "type": "string" } },
              "timeout": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?[smh]$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maximumSizeMb": { "type": "integer", "minimum": 64, "maximum": 32768 },
        "types": {
          "type": "array",
          "items": { "enum": ["nuget", "npm", "pip", "winget"] },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 1 } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["extends"] },
            { "required": ["includes"] },
            { "required": ["provisioning"] },
            { "required": ["cache"] }
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
