{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandforge.dev/schemas/package-manifest/v1.json",
  "title": "SandForge portable package manifest v1",
  "x-sandforge-contract": {
    "id": "package-manifest",
    "currentVersion": 1,
    "supportedVersions": [1]
  },
  "type": "object",
  "required": ["schemaVersion", "product", "version", "runtimeIdentifier", "createdAt", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "SandForge" },
    "version": { "type": "string", "minLength": 1 },
    "runtimeIdentifier": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "not": { "pattern": "(^[A-Za-z]:)|(^[/\\\\])|((^|[/\\\\])\\.\\.([/\\\\]|$))" }
          },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
